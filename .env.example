# CareAtlas Server Environment Configuration

# Server Port
PORT=5000

# Node Environment
NODE_ENV=development

# MongoDB Connection String (Leave blank or unset to run in Mock Memory Mode)
# Example: MONGODB_URI=mongodb://localhost:27017/careatlas
MONGODB_URI=

# Optional OpenAI API Key for Cloud AI Copilot (Leave blank to use built-in local deterministic copilot)
# Example: OPENAI_API_KEY=sk-...
OPENAI_API_KEY=

# Server-side Cloud AI Enablement flag (must be true AND user must consent in UI)
ENABLE_CLOUD_AI=false

# Max file upload size in megabytes (Default: 15MB)
MAX_FILE_SIZE_MB=15

# Upload storage directory
UPLOAD_DIR=./uploads
